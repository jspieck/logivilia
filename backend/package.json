{
  "name": "@logivilia/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Logivilia REST API (Express + Sequelize)",
  "main": "app.js",
  "scripts": {
    "start": "node ../app.js",
    "seed": "node ./seed",
    "test": "node --test test/*.test.js",
    "fix:nonograms": "node scripts/fixNonogramSizes.js",
    "check:nonograms": "node scripts/checkNonograms.js",
    "migrate:puzzles": "node scripts/migrateToPuzzles.js",
    "migrate": "node migrator.js up",
    "migrate:status": "node migrator.js status",
    "drop:legacy": "node scripts/dropLegacy.js",
    "test:mysql": "node --test --test-concurrency=1 test/*.test.js"
  },
  "license": "ISC",
  "dependencies": {
    "@logivilia/shared": "*",
    "bcryptjs": "^3.0.3",
    "bluebird": "^3.7.2",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.17.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.3",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "sequelize": "^6.6.2",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "sqlite3": "^6.0.1",
    "supertest": "^7.3.2"
  }
}
