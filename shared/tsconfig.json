{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false
  },
  "include": [
    "index.d.ts",
    "errorCodes.json",
    "puzzles/**/*.js"
  ]
}
