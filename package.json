{
  "name": "logivilia",
  "version": "1.0.0",
  "private": true,
  "main": "app.js",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build -w frontend",
    "dev": "concurrently -n api,web -c blue,green \"nodemon app.js\" \"npm run dev -w frontend\"",
    "dev:api": "nodemon app.js",
    "dev:web": "npm run dev -w frontend",
    "start": "node app.js",
    "deploy": "npm ci && npm run build && npm run start",
    "seed": "npm run seed -w backend",
    "migrate": "npm run migrate -w backend",
    "migrate:status": "npm run migrate:status -w backend",
    "lint": "npm run lint -w frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w backend",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    },
    "nodemon": {
      "minimatch": "^11.0.1"
    }
  }
}
