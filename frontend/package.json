{
  "name": "@logivilia/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore src",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@logivilia/shared": "*",
    "@oruga-ui/oruga-next": "^0.14.6",
    "@oruga-ui/theme-oruga": "^0.10.0",
    "@trevoreyre/autocomplete-vue": "^3.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "axios": "^1.21.1",
    "bulma": "^0.9.4",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.1.0",
    "sass": "^1.108.2",
    "vite": "^6.0.6",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^4.3.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-plugin-vue": "^9.17.0",
    "typescript": "^5.6.3"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "rules": {
      "no-console": "off",
      "vue/multi-word-component-names": "off"
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
