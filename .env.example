# Copy to .env and fill in. .env is git-ignored.
NODE_ENV=development
PORT=3000

# Database: MySQL only. For development, `docker compose up -d` starts one
# with these credentials (see docker-compose.yml).
DB_NAME=logivilia
DB_USER=logivilia
DB_PASSWORD=logivilia
DB_HOST=localhost
DB_PORT=3306
# Pending migrations are applied when the server starts. Set to false to run
# them by hand (npm run migrate); the server then refuses to start while any
# are pending.
DB_MIGRATE_ON_START=true

# Auth - at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Outgoing mail for password resets
SMTP_HOST=mail.logivilia.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=passwortreset@logivilia.com
SMTP_PASSWORD=
SMTP_FROM=passwortreset@logivilia.com
APP_URL=https://logivilia.com

# Comma-separated origins allowed to call the API cross-origin (optional;
# not needed when the frontend is served by this server)
ALLOWED_ORIGINS=
